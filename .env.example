# ---- App ----
PROJECT_NAME=SmartHire 2.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---- Database ----
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=smarthire
POSTGRES_PASSWORD=smarthire
POSTGRES_DB=smarthire

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- CORS ----
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- AWS S3 (KYC documents) ----
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_BUCKET=smarthire-kyc
S3_ACCESS_KEY=
S3_SECRET_KEY=
# When true, files are stored on local disk instead of S3 (dev)
STORAGE_USE_LOCAL=true
LOCAL_STORAGE_DIR=uploads

# ---- Public site (QR / share links) ----
PUBLIC_BASE_URL=http://localhost:5000

# ---- Seed admin ----
FIRST_ADMIN_EMAIL=admin@smarthire.io
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_NAME=System Administrator

# Paste your LinkedIn credentials here:
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_COMPANY_ID=your_linkedin_company_id_here
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Paste your Facebook credentials here:
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here